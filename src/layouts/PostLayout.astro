---
import Layout from "./Layout.astro";
import config from "@/config";

type Props = {
  title?: string;
  headline?: string;
  description?: string;
  ogImage?: string;
  canonicalURL?: string;
  alternateUrls?: { ko: string; en: string };
  pubDatetime?: Date;
  modDatetime?: Date | null;
};

const { site } = config;

const {
  title,
  headline,
  description,
  ogImage,
  canonicalURL,
  alternateUrls,
  pubDatetime,
  modDatetime,
} = Astro.props;

const pageURL = canonicalURL ?? new URL(Astro.url.pathname, Astro.site).href;

const structuredData = {
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  headline: headline ?? title ?? site.title,
  ...(description && { description }),
  image: ogImage,
  url: pageURL,
  mainEntityOfPage: { "@type": "WebPage", "@id": pageURL },
  inLanguage: Astro.currentLocale ?? site.lang,
  ...(pubDatetime && { datePublished: pubDatetime.toISOString() }),
  ...((modDatetime ?? pubDatetime) && {
    dateModified: (modDatetime ?? pubDatetime)!.toISOString(),
  }),
  author: [
    {
      "@type": "Person",
      name: site.author,
      ...(site.profile && { url: site.profile }),
    },
  ],
};
---

<Layout
  {title}
  {description}
  {ogImage}
  {canonicalURL}
  {alternateUrls}
  ogType="article"
>
  <Fragment slot="head">
    <link rel="preconnect" href="https://giscus.app" crossorigin />

    {
      pubDatetime && (
        <meta
          property="article:published_time"
          content={pubDatetime.toISOString()}
        />
      )
    }
    {
      modDatetime && (
        <meta
          property="article:modified_time"
          content={modDatetime.toISOString()}
        />
      )
    }

    <script
      type="application/ld+json"
      is:inline
      set:html={JSON.stringify(structuredData)}
    />
  </Fragment>

  <slot />
</Layout>
