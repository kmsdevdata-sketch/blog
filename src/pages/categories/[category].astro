---
import { getCollection } from "astro:content";

import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import Card from "@/components/Card.astro";

import { getSortedPosts } from "@/utils/getSortedPosts";
import config from "@/config";

type Props = Record<string, never>;

export function getStaticPaths() {
  return ["java", "spring", "cs", "db"].map(category => ({
    params: { category },
  }));
}

const categorySlug = Astro.params.category;

const categoryMap: Record<string, string> = {
  java: "Java",
  spring: "Spring",
  cs: "CS",
  db: "DB",
};

const categoryName = categoryMap[categorySlug ?? ""];

const posts = await getCollection(
  "posts",
  ({ data }) =>
    !data.draft &&
    data.category === categoryName &&
    data.lang === (Astro.currentLocale ?? config.site.lang)
);

const sortedPosts = getSortedPosts(posts);
const isEnglish = Astro.currentLocale === "en";
---

<Layout title={`${categoryName} | ${config.site.title}`}>
  <Header />

  <main class="app-layout py-12">
    <h1 class="text-3xl font-bold sm:text-4xl">
      {categoryName}
    </h1>

    <p class="text-muted-foreground mt-2">
      {isEnglish ? `Posts in ${categoryName}` : `${categoryName} 카테고리의 글`}
    </p>

    {
      sortedPosts.length > 0 ? (
        <ul class="mt-8">
          {sortedPosts.map(post => (
            <Card variant="h3" {...post} />
          ))}
        </ul>
      ) : (
        <p class="text-muted-foreground mt-10">
          {isEnglish ? "No posts yet." : "아직 작성된 글이 없습니다."}
        </p>
      )
    }
  </main>

  <Footer />
</Layout>
